<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>shops-build</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>shops-standalone</artifactId>
    <!-- Published at the plugin's own version. -->
    <version>${plugin.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Shops</name>
    <description>
        Rain's Shops, as a plugin of its own: the shops module and the standard wrapper, shaded together.
    </description>

    <properties>
        <plugin.name>RainsShops</plugin.name>
        <!-- 0.1.0: players' own shops — chests and barrels that sell and buy, a server-wide browser, reviews,
             statements, rent and a server cut. -->
        <!-- 0.1.1: /bazaar create and the other "this shop" commands also take the container clicked within the last
             minute, not only the one looked at exactly. -->
        <!-- 0.1.2: a /bazaar that fails says so and logs why; a refused shop opening is logged with its reason. -->
        <!-- 0.1.3: a shop or statue in somebody's claim opens for customers without Core's "you may not" first (handled at
             LOWEST, both hands); bound and insured items cannot be a shop's ware. -->
        <plugin.version>0.9.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>shops-module</artifactId>
            <!-- Not managed by the framework's parent (yet): this repository is newer than its 2.0.0. -->
            <version>${shops-module.version}</version>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- StandaloneJarTest reads the built jar, so it runs after the jar exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
